{
  "name": "timer",
  "version": "1.0.0",
  "repository": "https://github.com/zimekk/timer.git",
  "author": "Marcin Makarewicz <zimekk@gmail.com>",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^20.0.0 || ^22.0.0"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:react/recommended"
    ],
    "root": true,
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint",
      "prettier"
    ],
    "settings": {
      "react": {
        "version": "detect"
      }
    }
  },
  "eslintIgnore": [
    "lib/",
    "public/"
  ],
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{json,js,jsx,md,scss,ts,tsx,css,yml,yaml}": "prettier --write"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-organize-imports"
    ]
  },
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "rm -rf packages/*/dist packages/*/lib packages/*/node_modules/.vite packages/*/public",
    "coverage": "pnpm -r run coverage",
    "dev": "pnpm -r run dev",
    "lint": "eslint . --ext .json,.js,.jsx,.ts,.tsx",
    "preview": "pnpm -r run preview",
    "reset": "rm -rf node_modules packages/*/node_modules",
    "test": "pnpm -r run test",
    "update:dedupe": "pnpm dedupe",
    "update:latest": "pnpm -r up -i",
    "remote": "worker",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@dev/worker": "workspace:*",
    "@types/node": "^22.16.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "ts-node-dev": "^2.0.0",
    "type-coverage": "^2.29.7",
    "typescript": "^5.8.3"
  }
}
