    "remote": "bin/worker.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv": "^17.2.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0"
  }
}
